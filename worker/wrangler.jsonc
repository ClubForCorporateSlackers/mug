{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker の名前は URL（mug.<アカウント名>.workers.dev）になるので変えない
  "name": "mug",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // デプロイ・プレビュー・wrangler dev の前に、フロントをビルドして frontend/dist を作る。
  // ここに書いておけば、Cloudflare のビルド設定（ダッシュボード）を変えなくてよい。
  // プレビュー（main 以外のブランチ）では Storybook も frontend/dist/storybook に入る（package.json の build:worker）
  "build": {
    "command": "npm ci && npm run build:worker",
    "cwd": "../frontend",
    "watch_dir": "../frontend/src"
  },

  // 画面ファイル（frontend のビルド結果）。/api/* だけ Worker のコードを通し、それ以外はファイルをそのまま返す
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },

  // 秘密ではない設定だけをここに書く。AWS のキーは書かない（Secrets に置く）
  "vars": {
    "FUNCTION_URL": "https://r252x4iygtlopqgipa3lfu2brq0kupvv.lambda-url.ap-northeast-1.on.aws/"
  },

  // ログ（Workers Logs）。自動のリクエスト記録（invocation_logs）は、ヘッダー（X-Id-Token）が残るおそれがあるので切る。
  // コードから出すのは「メソッド・パス・ステータス」の1行だけ。ヘッダー・キー・本文・クエリは出さない
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },

  // プレビュー（npx wrangler preview / Workers Builds のプレビュー）用の設定。
  // プレビューは本番の設定を引き継がないので、必要なものをここにもう一度書く。
  // - assets はトップレベルだけに書く（プレビューでも同じものがアップロードされる）
  // - バックエンドはハッカソンなので本番と同じ関数URLを共用する
  // - Secrets（AWS のキー）はここに書かない。wrangler preview base-config secret put で登録する
  "previews": {
    "vars": {
      "FUNCTION_URL": "https://r252x4iygtlopqgipa3lfu2brq0kupvv.lambda-url.ap-northeast-1.on.aws/"
    },
    // 本番と同じ理由で、自動のリクエスト記録（invocation_logs）を切る。
    // 引き継がれるかがドキュメントで明記されていないので、はっきり書いておく
    "observability": {
      "enabled": true,
      "logs": {
        "invocation_logs": false
      }
    }
  }
}
