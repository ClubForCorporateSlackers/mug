iles" value="&lt;b&gt;地図タイル&lt;/b&gt;&lt;br&gt;地理院タイル（Leaflet）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontColor=#333333;arcSize=12;" vertex="1" parent="pD1"><mxGeometry x="1070" y="110" width="220" height="64" as="geometry"/></mxCell><mxCell id="pD-revgeo" value="&lt;b&gt;国土地理院API&lt;/b&gt;&lt;br&gt;緯度経度 → 市町村" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontColor=#333333;arcSize=12;" vertex="1" parent="pD1"><mxGeometry x="1070" y="560" width="220" height="64" as="geometry"/></mxCell><mxCell id="pD-e1" value="① 画面を開く" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#147EBA;fontColor=#147EBA;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pD1" source="pD-user" target="pD-front"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="343"/><mxPoint x="180" y="142"/></Array></mxGeometry></mxCell><mxCell id="pD-e2" value="② ログイン" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#147EBA;fontColor=#147EBA;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pD1" source="pD-user" target="pD-cognito"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pD-e3" value="③ API呼び出し（JWT付き）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#147EBA;fontColor=#147EBA;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pD1" source="pD-user" target="pD-apigw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="401"/><mxPoint x="180" y="592"/></Array></mxGeometry></mxCell><mxCell id="pD-e4" value="地図画像" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#888888;fontColor=#888888;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="pD1" source="pD-user" target="pD-tiles"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="372"/><mxPoint x="50" y="30"/><mxPoint x="1180" y="30"/></Array></mxGeometry></mxCell><mxCell id="pD-e5" value="トークン確認" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#888888;fontColor=#888888;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pD1" source="pD-apigw" target="pD-cognito"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="570"/><mxPoint x="450" y="372"/></Array></mxGeometry></mxCell><mxCell id="pD-e6" value="検証OKなら実行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="pD1" source="pD-apigw" target="pD-lambda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pD-e7" value="読み書き" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="pD1" source="pD-lambda" target="pD-ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pD-e8" value="市町村を取得" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pD1" source="pD-lambda" target="pD-revgeo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pD-e9" value="ログ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#888888;fontColor=#888888;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pD1" source="pD-lambda" target="pD-cw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="618"/><mxPoint x="760" y="772"/></Array></mxGeometry></mxCell><mxCell id="pD-note" value="&lt;b&gt;この構成のポイントと懸念点&lt;/b&gt;&lt;br&gt;・メリット：フロントはGitHubにpushするだけで自動デプロイ。フロント担当にAWSの権限を配らなくてよい&lt;br&gt;・メリット：JWTの検証はAPI Gatewayに任せられる。GETは誰でも、POSTだけログイン必須にできる&lt;br&gt;・費用：API Gatewayの数円程度だけ。アカウントのクレジットで相殺。それ以外は常時無料枠の範囲&lt;br&gt;・懸念：API GatewayのCORS設定でPagesのドメインを許可する必要がある&lt;br&gt;・懸念：APIのURLとCognitoのIDを、Pagesの環境変数に登録する必要がある&lt;br&gt;・懸念：管理するアカウントが2つになる（IaCで管理できるのはAWS側だけ）。クレジット切れ後は課金が始まる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBED;strokeColor=#AF7E04;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#1a1a1a;arcSize=3;" vertex="1" parent="pD1"><mxGeometry x="40" y="960" width="1280" height="184" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pC" name="案C_API Gateway版"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1200" math="0" shadow="0"><root><mxCell id="pC0"/><mxCell id="pC1" parent="pC0"/><mxCell id="pC-title" value="&lt;b&gt;案C：AWSのみ（API Gateway）&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="pC1"><mxGeometry x="40" y="-90" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pC-sub" value="JWTの検証をAPI Gatewayに任せる構成。すべてCDKで管理できる" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="pC1"><mxGeometry x="40" y="-56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="pC-cloud" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="pC1"><mxGeometry x="240" y="60" width="760" height="850" as="geometry"/></mxCell><mxCell id="pC-region" value="東京リージョン（ap-northeast-1）" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="pC1"><mxGeometry x="260" y="300" width="720" height="590" as="geometry"/></mxCell><mxCell id="pC-ext" value="&lt;b&gt;外部の無料サービス&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B0B0B0;dashed=1;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=8;fontSize=14;fontColor=#595959;arcSize=3;" vertex="1" parent="pC1"><mxGeometry x="1040" y="60" width="280" height="850" as="geometry"/></mxCell><mxCell id="pC-user" value="ユーザー&lt;br&gt;（スマホのブラウザ）" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;strokeWidth=1.5;" vertex="1" parent="pC1"><mxGeometry x="80" y="336" width="40" height="72" as="geometry"/></mxCell><mxCell id="pC-front" value="CloudFront&lt;br&gt;&lt;font color=&quot;#595959&quot;&gt;画面を配信&lt;/font&gt;" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPos