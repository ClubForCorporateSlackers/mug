mxCell><mxCell id="pA-e9" value="ログ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#888888;fontColor=#888888;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pA1" source="pA-lambda" target="pA-cw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="618"/><mxPoint x="760" y="772"/></Array></mxGeometry></mxCell><mxCell id="pA-note" value="&lt;b&gt;この構成のポイントと懸念点&lt;/b&gt;&lt;br&gt;・メリット：常時無料枠だけで動く。ハッカソン後もそのまま無料で残せる。すべてCDKで管理できる&lt;br&gt;・懸念：JWTの検証コードをLambdaに自分で書く必要がある。実装ミスがあると、未ログインでも投稿できてしまう&lt;br&gt;・懸念：フロントを更新するたびに、ビルド→S3へアップロード→キャッシュ削除が必要（手動 or CI/CDを自作）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBED;strokeColor=#AF7E04;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#1a1a1a;arcSize=3;" vertex="1" parent="pA1"><mxGeometry x="40" y="960" width="1280" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pB" name="案B_Cloudflare＋AWS"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1200" math="0" shadow="0"><root><mxCell id="pB0"/><mxCell id="pB1" parent="pB0"/><mxCell id="pB-title" value="&lt;b&gt;案B：Cloudflare Pages ＋ Lambda関数URL&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="pB1"><mxGeometry x="40" y="-90" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pB-sub" value="画面の配信だけCloudflare Pagesに置き換えた案A。完全に無料" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="pB1"><mxGeometry x="40" y="-56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="pB-cfg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5ED;strokeColor=#F38020;dashed=1;arcSize=4;" vertex="1" pa