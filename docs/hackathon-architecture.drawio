8;fontColor=#888888;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="pC1" source="pC-lambda" target="pC-cw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="618"/><mxPoint x="760" y="772"/></Array></mxGeometry></mxCell><mxCell id="pC-note" value="&lt;b&gt;この構成のポイントと懸念点&lt;/b&gt;&lt;br&gt;・メリット：JWTの検証はAPI Gatewayに任せられる。すべてAWSなのでCDKで一元管理できる&lt;br&gt;・費用：API Gatewayの数円程度だけ。アカウントのクレジットで相殺&lt;br&gt;・懸念：フロントを更新するたびに、ビルド→S3へアップロード→キャッシュ削除が必要（手動 or CI/CDを自作）&lt;br&gt;・懸念：フロント担当が自分でデプロイするには、AWSの権限を渡すか、CI/CDを作る必要がある&lt;br&gt;・懸念：クレジット切れ後は課金が始まる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBED;strokeColor=#AF7E04;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#1a1a1a;arcSize=3;" vertex="1" parent="pC1"><mxGeometry x="40" y="960" width="1280" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pA" name="案A_AWSのみ"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1200" math="0" shadow="0"><root><mxCell id="pA0"/><mxCell id="pA1" parent="pA0"/><mxCell id="pA-title" value="&lt;b&gt;案A：AWSのみ（Lambda関数URL）&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="pA1"><mxGeometry x="40" y="-90" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pA-sub" value="API Gatewayを使わず、Lambdaの関数URLで公開する構成。完全に無料" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#595959;" vertex="1" parent="pA1"><mxGeometry x="40" y="-56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="pA-cloud" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.grou